# .gitignore 文件内容

# 1. 含个人信息的文件
.env
.env.local
*.key
secrets.json

# 2. Python 产生的垃圾文件/缓存 (保持仓库整洁)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# 3. 你的本地数据文件 (Excel/CSV 不需要上传，除非是用来做演示的样本)
*.xlsx
*.csv
!example_data.xlsx  # 感叹号表示：除了这个文件例外，我要上传它作为示例
# 季度分拣的抽检子清单是流程正式产物，入库留痕
!codex_review/runs/**/*.csv
# 季度分拣的运行日志不入库
codex_review/logs/

# 6. 运行时生成的数据目录（体积大，不上传）
s01_data_collector_filter/data/
s01a_news_crawler/data/
s01b_project_extractor/data/
s02a_duplicate_merger/data/
s02b_entity_normalizer/data/
s02c_cross_verification/data/
s03_data_exporter/data/
# 例外：保留目录占位符（如有）
!**/data/.gitkeep
!**/data/**/.gitkeep

# 7. 交叉验证缓存（体积大，GDELT 文章数据 + 向量嵌入）
**/verification_cache/
**/manual_review/

# 8. SQLite 数据库文件
*.db
*.sqlite
*.db.bak_*

# 9. AI 提取原始结果快照（运行产物，体积大）
**/All_AI_Results_*.json

# 4. 系统文件
.DS_Store
Thumbs.db
uv.lock
.claude/worktrees/


# 5. VS Code 配置 (可选，如果你不想上传你的个人编辑器配置)
.vscode/

# eval 评测本地产物（不入 git）；gold_set 是昂贵人工产物必须入 git（2026-07-04 曾随 worktree 丢失）
eval/cache/
eval/reports/
eval/draft*.csv
eval/*.log

# review 复核模块运行产物（不入 git）
review/reports/
review/data/
review/*.log
review/*.csv
# .bak 备份：project_extractor_tool 用 .bak.YYYYMMDD（点号），run_review 用 .bak_YYYYMMDD（下划线）
*.db.bak.*
*.db.bak_*

# s04_web_visualization
s04_web_visualization/frontend/node_modules/
s04_web_visualization/frontend/dist/
s04_web_visualization/backend/.venv/
# SDD 执行台账（本地 scratch，不入库）
.superpowers/
