# .gitignore 文件内容

# 1. 含个人信息的文件
.env
.env.local
*.key
secrets.json

# 2. Python 产生的垃圾文件/缓存 (保持仓库整洁)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# 3. 你的本地数据文件 (Excel/CSV 不需要上传，除非是用来做演示的样本)
*.xlsx
*.csv
!example_data.xlsx  # 感叹号表示：除了这个文件例外，我要上传它作为示例

# 6. 运行时生成的数据目录（体积大，不上传）
s01_data_collector_filter/data/
s02a_duplicate_merger/data/
s02b_cross_verification/data/
s03_data_exporter/data/
# 例外：保留目录占位符（如有）
!**/data/.gitkeep
!**/data/**/.gitkeep

# 7. 交叉验证缓存（体积大，GDELT 文章数据 + 向量嵌入）
**/verification_cache/
**/manual_review/

# 8. SQLite 数据库文件
*.db
*.sqlite

# 4. 系统文件
.DS_Store
Thumbs.db
uv.lock


# 5. VS Code 配置 (可选，如果你不想上传你的个人编辑器配置)
.vscode/