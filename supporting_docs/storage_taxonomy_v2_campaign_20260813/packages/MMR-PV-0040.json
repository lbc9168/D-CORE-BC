{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"缅甸","country_iso":"MMR","created_at":"2026-07-02T13:21:03.166557","excluded":0,"excluded_reason":null,"id":"MMR-PV-0040","ldc":"Yes","location":"","location_norm":"","name_en_quality":"ai_translated","project_name":"缅甸德比瓦40兆瓦光伏项目","project_name_en":"","subcategory":"光储"},"events":[{"articles":[{"author":"云南省电力设计院","content":"4月29日，中国能建中电工程云南院勘察设计的缅甸达西40兆瓦光伏项目、\n缅甸德比瓦40兆瓦光伏项目\n举行投产仪式，\n标志着\n项\n目正式投产发电\n两个光伏项目是\n缅甸目前投产规模最大的光伏发电项目。\n缅甸电力能源部部长吴哥哥伦出席投产仪式\n缅甸电力能源部部长吴哥哥伦及相关政府部门、金色能源公司、云南院、境内外相关企业代表出席投产仪式。\n云南院在承担两个缅甸光伏项目设计任务后，组建了多部门专业的设计团队，在项目业主缅甸金色能源公司牵头组织下，设计团队积极克服现场高温、交通不便以及复杂的安全局势等挑战。尤其在缅甸中部7.9级大地震后，设计团队克服重重困难，全程参与现场踏勘选址、设计交底、现场技术服务、工程调试等各环节工作，并在设计过程中充分融入了8级抗震设计，以过硬的专业技术实力，圆满完成了各项设计任务。\n缅甸达西40兆瓦光伏项目\n该批项目是云南院在境外首次采用平单轴跟踪发电及配20%两小时储能的光伏发电项目。项目建成后，年均发电2亿千瓦时，可极大缓解缅甸电力短缺的局面，助力缅甸绿色低碳发展，支持区域经济发展和保障居民用电。\n缅甸德比瓦40兆瓦光伏项目\n此次工程顺利投产，是缅中两国电力建设者同心协力、攻坚克难的成果。下一步，云南院将以该批项目投产为新起点，继续全力配合好缅甸金色能源公司正在建设的210兆瓦光伏项目勘察设计，积极投身高质量共建“一带一路”能源电力项目建设，助力打造缅甸中部清洁能源发电基地。","content_sha256":"2cd1c2029ee07d107cd323d61763ce47af524d1fdccd533ffcaee6cb478485ec","id":27354,"publish_date":"2026-05-01 19:41:39","title":"云南院勘察设计的两个缅甸光伏项目投产发电","title_sha256":"d7a1e8d28a865a6a6c577706bf9ae2449fb7f295cbc171751e57da934da42d65","url":"https://news.goalfore.cn/topstories/detail/94647.html"}],"event":{"additional_remarks":"","canonical_id":"MMR-PV-0040","capacity_details":"","capacity_mw":40.0,"capacity_mw_raw":"40.0","capacity_source":"original","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-07-02T13:21:03.171445","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"MMR-PV-0040-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"金色能源公司","project_developer_en":"Golden Energy Company","project_stage":"投入运营","project_summary":"中国能源建设集团有限公司在缅甸承建的德比瓦40兆瓦光伏项目已投入运营。","publish_date":"2026-05-01 19:41:39","pv_capacity_mw":40.0,"source_links":"[\"https://news.goalfore.cn/topstories/detail/94647.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"MMR-PV-0040","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
