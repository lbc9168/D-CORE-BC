{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"No","category":"储能","country":"英国","country_iso":"GBR","created_at":"2026-03-23T10:35:49.011023","excluded":0,"excluded_reason":null,"id":"GBR-ES-0015","ldc":"No","location":"苏格兰","location_norm":null,"name_en_quality":"ai_translated","project_name":"英国苏格兰科尔本一号储能项目","project_name_en":"Coalburn 1 Energy Storage Project (Scotland, UK)","subcategory":null},"events":[{"articles":[{"author":"阿特斯阳光电力集团","content":"阿特斯阳光电力集团股份有限公司旗下储能子公司e-STORAGE（简称“阿特斯储能”）宣布获得哥本哈根基础设施伙伴旗舰基金的供应和集成合同，为其位于英国苏格兰的“科尔本一号（Coalburn 1）”项目提供500兆瓦/1170兆瓦时的储能系统解决方案。\n“科尔本一号（Coalburn 1）”项目计划于2025年第一季度并网投运，届时预计将成为英国最大的储能项目。\n1.17GWh“科尔本一号（Coalburn 1）”储能项目将安装业界领先的阿特斯Solbank储能系统，进一步提升电站的能源使用效率，有效调节当地电力需求和供给的平衡，提高英国电网的稳定性和可靠性。\n该项目位于苏格兰的一个前煤矿社区，在减少碳排放、改善空气质量以及为全球应对气候变化做出贡献方面发挥着至关重要的作用。该项目投运后，预计在未来14年可减少约160万吨二氧化碳排放。\n阿特斯储能e-STORAGE总裁Colin Parkin表示\n：“我们很荣幸能够与哥本哈根基础设施伙伴旗舰基金合作，实施英国最大的储能项目。通过这个项目，阿特斯仅在英国市场就累计交付了近2GWh的储能系统。我们很高兴能够支持英国推动可再生能源的高效交付，增强对未来气候变化的适应能力，同时有助于降低消费者的能源成本。”\n阿特斯SolBank是专为大型地面电站设计和制造的的集装箱式储能系统解决方案，采用高可靠且长循环寿命的磷酸铁锂（LFP）电池技术，以及主动均衡电池管理系统（BMS）和高效的热管理系统（TMS），是大型地面电站应用中，最安全、最可靠的储能系统之一。","content_sha256":"e8c9877d8b07e306900c1bcc3924b8fd29411fe292d206eef77066d2736c726c","id":10609,"publish_date":"2023-12-08 16:28:30","title":"1.17GWh！阿特斯为英国最大储能项目提供储能系统","title_sha256":"b0dc333a3b97718ab7f2ae59cc017f5c83d5dc67b12ec08fc8b3a0ab5946c6dd","url":"https://news.goalfore.cn/topstories/detail/55321.html"}],"event":{"additional_remarks":"","canonical_id":"GBR-ES-0015","capacity_details":"BESS: 500MW/1170MWh","capacity_mw":500.0,"capacity_mw_raw":"500","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:35:49.011956","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"GBR-ES-0015-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://cn.csisolar.com/press/1-17gwh%EF%BC%81%E9%98%BF%E7%89%B9%E6%96%AF%E4%B8%BA%E8%8B%B1%E5%9B%BD%E6%9C%80%E5%A4%A7%E5%82%A8%E8%83%BD%E9%A1%B9%E7%9B%AE%E6%8F%90%E4%BE%9B%E5%82%A8%E8%83%BD%E7%B3%BB%E7%BB%9F/\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"哥本哈根基础设施伙伴旗舰基金","project_developer_en":"Copenhagen Infrastructure Partners Flagship Fund","project_stage":"签约","project_summary":"阿特斯阳光电力集团股份有限公司（阿特斯）通过其子公司e-STORAGE，为位于英国苏格兰的“科尔本一号（Coalburn 1）”储能项目提供储能系统解决方案。该项目装机容量为500兆瓦/1170兆瓦时，预计于2025年第一季度并网投运，建成后将成为英国最大的储能项目。","publish_date":"2023-12-08 16:28:30","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/55321.html\"]","storage_energy_mwh":1170.0,"storage_power_mw":500.0,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"GBR-ES-0015","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["existing_storage_numeric","storage_text_signal"]}
