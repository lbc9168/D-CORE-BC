{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"津巴布韦","country_iso":"ZWE","created_at":"2026-03-23T10:26:25.719792","excluded":0,"excluded_reason":null,"id":"ZWE-PV-0004","ldc":"No","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"津巴布韦Bikita矿山配套光伏发电项目","project_name_en":"Zimbabwe Bikita Mine Supporting Photovoltaic Power Project","subcategory":"光储"},"events":[{"articles":[{"author":"中矿资源","content":"近日，中矿资源集团股份有限公司津巴布韦Bikita矿山配套光伏发电项目主体工程建设完成，成功并网发电。\n该项目建设周期4个月，投资9088万元人民币，设计发电量2100万度/年。目前，最大单日发电量8万度、平均5.75万度，所发电量占比矿山每日用电量达到20%以上，大大降低了使用柴油发电机的用电成本（每度光伏发电成本是每度柴油发电成本的近1/20）。随着津巴布韦雨季结束和储能站安装完成，后续将会更稳定更高效地为矿山提供电力，进一步增加新能源用电比例。\n该项目是津巴布韦第一个带储能的光伏发电站，也是第一个市电+柴油发电站+光伏+储能的能源系统。这一项目的建成，标志着中矿资源再次以低碳环保的实际行动践行了在非洲的可持续发展理念，将为津巴布韦政府、企业利用太阳能发电起到很好的示范引领作用。","content_sha256":"54ccbdf2f6b6a7c757f7a14be2accc831d728eb32dfbafceb5f30bbc586a4999","id":9192,"publish_date":"2024-03-14 13:06:02","title":"中矿资源集团津巴布韦Bikita矿山配套光伏发电项目主体工程建成并投入使用","title_sha256":"6eae7a9060eb1ecbfec5fb4bb24d627c87060fe42b2414d43603298613c65f97","url":"https://news.goalfore.cn/topstories/detail/61901.html"}],"event":{"additional_remarks":"","canonical_id":"ZWE-PV-0004","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:26:25.719934","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"ZWE-PV-0004-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.sinomine.cn/xwdti/188.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"中色矿业集团有限公司","project_developer_en":"China Mining Resources Group Company Limited","project_stage":"投入运营","project_summary":"中矿资源集团在津巴布韦的Bikita矿山建设了一个配套光伏发电项目，总装机容量未明确，但设计年发电量为2100万度。该项目已建成并投入使用，是津巴布韦首个带储能的光伏电站。","publish_date":"2024-03-14 13:06:02","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/61901.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":1245.07,"total_investment_usd_raw":"约1245.07","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"ZWE-PV-0004","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category","storage_text_signal"]}
