{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"储能","country":"柬埔寨","country_iso":"KHM","created_at":"2026-03-23T09:36:48.136927","excluded":0,"excluded_reason":null,"id":"KHM-ES-0001","ldc":"Yes","location":"茶胶省","location_norm":null,"name_en_quality":"ai_translated","project_name":"柬埔寨茶胶省150MW/300MWh电池储能项目","project_name_en":"Cambodia Takeo Province 150MW/300MWh Battery Energy Storage Project","subcategory":null},"events":[{"articles":[{"author":"中国重机","content":"成功签约电池储能项目新增合同\n近日，以中国重机为牵头方组成的联合体，在成功中标并签约柬埔寨茶胶省100MW/200MWh电池储能项目的基础上，与柬埔寨国家电力公司（以下简称“EDC”）进一步深化合作，正式签署了该项目新增合同，将项目规模提升至150MW/300MWh。该项目增补完成后将极大增强当地电网的调峰调频能力，保障供电安全，为柬埔寨经济社会发展提供更坚实稳定的电力支撑。\n此次通过新增合同实现项目规模的扩容，不仅彰显了业主EDC对中国重机及联合体技术实力、工程执行能力的高度信任，更体现了双方共同致力于提升柬埔寨电网稳定性、促进可再生能源消纳、加速能源绿色转型的坚定决心。","content_sha256":"07b678917864903fedf2c0ed284c45198bdb8b8fc4083c4eb60a4e32690adbed","id":469,"publish_date":"2026-01-13 08:20:19","title":"中国重机成功签约柬埔寨电池储能项目新增合同","title_sha256":"acb25ee7a1655081e595ca911ace838ed75fe54c87d4157745b23813147e0c95","url":"https://news.goalfore.cn/topstories/detail/91741.html"}],"event":{"additional_remarks":"","canonical_id":"KHM-ES-0001","capacity_details":"BESS: 150MW","capacity_mw":150.0,"capacity_mw_raw":"150","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:36:48.136980","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"KHM-ES-0001-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://finance.sina.com.cn/roll/2026-01-14/doc-inhhfvzc7380551.shtml\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"柬埔寨国家电力公司","project_developer_en":"Electricité du Cambodge (EDC)","project_stage":"签约","project_summary":"中国重机牵头联合体在柬埔寨茶胶省签约了150MW/300