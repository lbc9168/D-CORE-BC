{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"沙特阿拉伯","country_iso":"SAU","created_at":"2026-04-10T08:23:26.695837","excluded":0,"excluded_reason":null,"id":"SAU-HB-0026","ldc":"No","location":"利雅得省, 纳季兰省, 吉赞省, 哈伊勒省","location_norm":null,"name_en_quality":"ai_translated","project_name":"沙特4.5GW风电光伏项目","project_name_en":"Saudi Arabia 4.5GW Wind and Solar PV Project","subcategory":null},"events":[{"articles":[{"author":"NA","content":"沙特国家可再生能源计划（NREP）项目开发加速推进。继2024年年初第五轮项目资格预审及5月签署第四轮风电项目PPA后，近期沙特电力采购公司（SPPC）发布第六轮项目RFQ。\n第六轮项目总容量为4.5GW，包括以下\n1个风电项目和4个光伏项目\n：\n利雅得省Dawadmi 风电IPP（1.5GW）\n纳季兰省Najran 光伏IPP（1.4GW）\n吉赞省Samtah 光伏IPP（600MW）\n吉赞省Ad Darb 光伏IPP（600MW）\n哈伊勒省As Sufun 光伏IPP（400MW）\nNREP即根据沙特2030年愿景制定的一项战略举措，旨在到2030年将可再生能源在发电结构占比提高到50%左右。目前为止，NREP框架下可再生能源项目规模已\n超过19GW\n。\n根据NREP近几轮项目来看，项目招标和PPA签署的推进节奏逐渐加快。2023年11月，SPPC开启第五轮项目资格预审，3个月后公开资格预审结果，晶科、国家电投黄河水电、中国电建等进入名单，目前投标已截止，有望于未来几个月宣布最终中标情况。","content_sha256":"39e3172d87a009d56ea90d1297fa45b548675b74da9c9937373ae7f748df1c20","id":6687,"publish_date":"NA","title":"沙特电力采购公司4.5GW风电+光伏项目招标","title_sha256":"150c0c55de404815c94ea7cd314d22bb2e474e01fae768315cdd38b577f67760","url":"https://news.goalfore.cn/topstories/detail/72188.html"}],"event":{"additional_remarks":"","canonical_id":"SAU-HB-0026","capacity_details":"风电: 1500MW, 光伏: 3000MW","capacity_mw":4500.0,"capacity_mw_raw":"4500","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-04-10T08:23:26.697512","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"SAU-HB-0026-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.moenergy.gov.sa/zh/media-center/news/principal-buyer-awards-five-renewable-projects-achieving-new-record-capacity\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"沙特电力采购公司","project_developer_en":"Saudi Power Procurement Company (SPPC)","project_stage":"拟开发","project_summary":"中国企业晶科和国家电投黄河水电参与了沙特国家可再生能源计划（NREP）第六轮项目（总计4.5GW）的投标。该计划旨在提高沙特可再生能源发电占比，目前已超过19GW。项目包括利雅得省Dawadmi风电IPP（1.5GW）等五个子项目，投标已截止，预计未来数月公布中标结果。","publish_date":"2024-09-27 13:30:21","pv_capacity_mw":3000.0,"source_links":"[\"https://news.goalfore.cn/topstories/detail/72188.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"SAU-HB-0026","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
