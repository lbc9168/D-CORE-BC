{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"南非","country_iso":"ZAF","created_at":"2026-03-23T10:05:33.987013","excluded":0,"excluded_reason":null,"id":"ZAF-HB-0004","ldc":"No","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"南非光伏储能项目","project_name_en":"South Africa Solar PV and Energy Storage Project","subcategory":"光储"},"events":[{"articles":[{"author":"约翰内斯堡分行","content":"11月18日，中国银行约翰内斯堡分行为中国电力建设集团下辖某公司开出约6000万美元的履约保函，保函受益人为南非某大型新能源开发商。在该保函项下，中国电力建设集团某公司在南非建设大型光伏储能项目，为南非缓解电力紧张、绿色能源转型贡献中国力量。\n保函是中国银行传统优势业务，中行开立的保函为南非本地业主普遍接受。约堡分行与境内银行联动，可为中资企业提供快速高效的保函转开和内保外贷业务，约堡分行也可以独立为客户开立各类保函。约堡分行拥有保函专家团队，中英文服务，沟通效率高。保函的服务效率和业务收费在南非市场极具竞争力。","content_sha256":"7ee55852d065dfc5cdc8c067f574a785686dc7a1817da38b8be7d5352020dd4f","id":5845,"publish_date":"2024-11-20 09:23:07","title":"中行约堡分行为南非新能源项目开立履约保函","title_sha256":"4ced4264092c4724b8cd6e55ca862269679c0673ae435bef34f6d65b223355d8","url":"https://news.goalfore.cn/topstories/detail/74987.html"}],"event":{"additional_remarks":"","canonical_id":"ZAF-HB-0004","capacity_details":"PV, BESS","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:05:33.987118","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"ZAF-HB-0004-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.powerchina.cn/col/col7449/art/2026/art_1863041819.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"南非某大型新能源开发商","project_developer_en":"South African Major New Energy Developer","project_stage":"在建","project_summary":"中国电力建设集团下辖某公司在南非建设大型光伏储能项目，具体装机容量未披露。中国银行约翰内斯堡分行为此项目开立了约6000万美元的履约保函，项目处于建设阶段。","publish_date":"