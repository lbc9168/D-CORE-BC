{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"苏里南","country_iso":"SUR","created_at":"2026-03-23T09:52:33.574513","excluded":0,"excluded_reason":null,"id":"SUR-HB-0004","ldc":"No","location":"萨拉玛卡省","location_norm":null,"name_en_quality":"ai_translated","project_name":"苏里南村庄微电网光伏项目（二期）博托帕西微电网项目","project_name_en":"Suriname Village Microgrid PV Project (Phase II) - Botopasi Microgrid Project","subcategory":"光储"},"events":[{"articles":[{"author":"江西电建","content":"苏里南副总统龙尼·布林斯韦克（左二）、自然资源部部长大卫·阿比亚莫福（右三）亲临项目现场\n当地时间4月25日，苏里南副总统龙尼·布林斯韦克，自然资源部部长大卫·阿比亚莫福一行莅临由江西电建公司承建的苏里南村庄微电网光伏项目（二期），参加第二站点——博托帕西微电网项目完工揭牌及点灯仪式。\n龙尼·布林斯韦克对项目团队克服环境恶劣、条件艰苦等诸多不利影响，高质高效完成项目建设给予高度肯定和赞扬，期待团队继续发扬优势，按期完成后续各项建设任务。\n苏里南村庄微电网光伏项目（二期）位于苏里南萨拉玛卡省苏里南河沿岸和马罗韦纳河沿岸，为光伏、储能、柴发混合能源的离网型微电网项目，总覆盖45个森林村落，总计光伏装机5.349兆瓦，储能18.6兆瓦时，柴油发电机总计容量2.813兆伏安，建成后年发电量8780兆瓦时。自开工以来累计签订、增补3次合同，目前共计9个站点。\n博托帕西微电网项目是苏里南村庄微电网光伏项目（二期）中第二个完成建设的项目（站点），总计光伏装机1020千瓦，储能2580千瓦时，柴油发电机总量800千伏安，年发电量1600兆瓦时，将为11个森林村落提供全天候稳定供电，全面提升当地居民生活品质，为社会发展筑牢能源根基。","content_sha256":"3ce47e64d5f7a68dfa0282b4af18e417c46ddfce1b6201ae6c275dd0a385136e","id":3866,"publish_date":"2025-04-28 17:39:02","title":"江西电建苏里南村庄微电网光伏项目（二期）博托帕西微电网项目完工揭牌","title_sha256":"aa10a64ed53c920e2d944a87a3115a74e5fea093acd9bb7a1f9251d99ba9f191","url":"https://news.goalfore.cn/topstories/detail/82085.html"}],"event":{"additional_remarks":"","canonical_id":"SUR-HB-0004","capacity_details":"PV: 1020kW, BESS: 2580kWh, Diesel Generator: 800kVA","capacity_mw":1.02,"capacity_mw_raw":"1.02","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:52:33.575133","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"SUR-HB-0004-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.powerchina.cn/col7440/art/2024/art_7440_1910411.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"江西电建","project_developer_en":"Jiangxi Electric Power Construction","project_stage":"竣工","project_summary":"江西电建在苏里南承建的村庄微电网光伏项目（二期）的博托帕西微电网项目已完工。该项目为光伏、储能、柴发混合能源的离网型微电网，总装机容量为1.02兆瓦，将为11个森林村落提供电力。","publish_date":"2025-04-28 17:39:02","pv_capacity_mw":1.02,"source_links":"[\"https://news.goalfore.cn/topstories/detail/82085.html\"]","storage_energy_mwh":2.58,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"SUR-HB-0004","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category","existing_storage_numeric","storage_text_signal"]}
