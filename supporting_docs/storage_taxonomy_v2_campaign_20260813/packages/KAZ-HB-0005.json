{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"哈萨克斯坦","country_iso":"KAZ","created_at":"2026-03-23T09:40:43.209191","excluded":0,"excluded_reason":null,"id":"KAZ-HB-0005","ldc":"No","location":"奇姆肯特","location_norm":null,"name_en_quality":"ai_translated","project_name":"哈萨克斯坦奇姆肯特1000吨/日垃圾焚烧发电厂","project_name_en":"Kazakhstan Shymkent 1000 t/d Waste-to-Energy Plant","subcategory":null},"events":[{"articles":[{"author":"北极星垃圾发电圈","content":"哈萨克斯坦生态和自然资源部近日与中国陕西建工集团（Shaanxi Construction Engineering）和东方希望集团（East Hope Group）签署了关于在阿斯塔纳和奇姆肯特市投资建造垃圾焚烧发电厂协议。\n消息称，根据该投资协议，计划在阿斯塔纳建造一座日处理能力为\n1500吨生活垃圾（约合每年55万吨）的垃圾处理厂。\n该项目总投资为944亿坚戈（约合1.8亿美元）。\n此外，将在奇姆肯特建造一座日处理能力\n为1000吨（约每年36万吨）的垃圾处理厂。\n该项目投资额为539亿坚戈（约合1亿美元）。\n项目实施过程中，将创造超过 550 个临时就业岗位和约 200 个永久性就业岗位。\n生态部称，这些设施的投产将大大减少送往垃圾填埋场的垃圾量，并产生环保电力。","content_sha256":"4b89f8f4fabf6366e55ef9ebf59270688a4401426fed062a4adfa9767aaf6eab","id":1295,"publish_date":"2025-11-05 17:17:04","title":"1500+1000t/d！中企将在哈萨克斯坦投建两座垃圾焚烧厂","title_sha256":"63e2a30b8b55901c35b9150037ebcd0bb98b5feff065a21fe248518525bddbf0","url":"https://news.goalfore.cn/topstories/detail/89655.html"}],"event":{"additional_remarks":"","canonical_id":"KAZ-HB-0005","capacity_details":"日处理能力: 1000吨生活垃圾","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:40:43.209496","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"KAZ-HB-0005-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://finance.sina.cn/2025-12-05/detail-infztyiw9840376.d.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"陕西建工控股集团有限公司; 东方希望集团有限公司","project_developer_en":"SCEGC; East Hope Group","project_sta