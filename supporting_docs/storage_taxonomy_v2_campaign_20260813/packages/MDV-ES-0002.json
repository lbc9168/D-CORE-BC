{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"储能","country":"马尔代夫","country_iso":"MDV","created_at":"2026-03-23T10:50:07.397287","excluded":0,"excluded_reason":null,"id":"MDV-ES-0002","ldc":"No","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"马尔代夫40MWh储能EPC项目","project_name_en":"Maldives 40MWh BESS EPC Project","subcategory":null},"events":[{"articles":[{"author":"中腾微网","content":"2023年07月13日，中腾微网（北京）科技有限公司携手合作伙伴成功中标马尔代夫40MWh储能EPC总承包项目。项目包括两个标段共40MWh储能系统的设计、供货及安装调试工作。\n通过专业的设计实力，过硬的技术支持能力，以及深耕多年的服务经验，中腾微网已帮助马尔代夫境内几十个岛屿实现了新能源电力改造工程。此次中标的储能项目是中腾微网在马尔代夫地区的第四个微电网项目，截止目前，中腾微网在马尔代夫进行电力建设与改造的项目岛总数量已达到84个。\n马尔代夫40MWh储能EPC总承包项目是马尔代夫政府发起的加快可再生能源一体化和可持续发展项目（ARISE）的一部分，此次项目的主要工作包含项目指定岛屿微电网系统的设计、产品供货、储能系统的安装和调试（BESS包括储能单元(电池)、电池管理系统(BMS)、PCS等设备），以及能量管理系统(EMS)的安装调试等工作。\n值得关注的是，马尔代夫40MWh储能EPC总承包项目将集成中腾微网自主研发的EMS能量管理系统以及SP系列储能逆变器等产品，实现多能源模块间的平衡互补，智能化调控。并配合中腾微网全球数据管理平台（GDP），对微电网各发电模块和运行设备进行集中管理和监控，优化岛屿原有供电的柴油发电系统，与智能化的储能系统有机的结合起来，一方面能够实现高效绿色的电力供应，又能保障这些岛屿电力系统安全稳定的运行。","content_sha256":"726cc9f5207428aeee30275b6c5d5322c39931407fe28c019327fc03c410f792","id":12833,"publish_date":"2023-07-14 21:11:52","title":"中腾微网成功中标马尔代夫40MWh储能EPC项目","title_sha256":"e1fa88bcfb90d9d2a4ac23427228cadd9eec68026cd82432760decf0581ca1d9","url":"https://news.goalfore.cn/topstories/detail/42913.html"}],"event":{"additional_remarks":"","canonical_id":"MDV-ES-0002","capacity_details":"BESS: 40MWh","capacity_mw":40.0,"capacity_mw_raw":"40","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:50:07.397567","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"MDV-ES-0002-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.cnesa.org/information/detail/?column_id=69&id=5645\"]","official_website_links":"[\"https://www.sinosoarhybrid.com/zh/40mwh-energy-storage-project-maldives-cn/\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"马尔代夫政府","project_developer_en":"Government of Maldives","project_stage":"中标","project_summary":"中腾微网（北京）科技有限公司中标马尔代夫40MWh储能EPC总承包项目。该项目是马尔代夫政府ARISE项目的一部分，旨在为岛屿微电网系统提供储能解决方案，以实现高效绿色的电力供应和安全稳定的运行。","publish_date":"2023-07-14 21:11:52","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/42913.html\"]","storage_energy_mwh":40.0,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"MDV-ES-0002","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["existing_storage_numeric","storage_text_signal"]}
