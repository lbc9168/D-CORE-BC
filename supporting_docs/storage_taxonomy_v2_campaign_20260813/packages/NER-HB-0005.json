{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"尼日尔","country_iso":"NER","created_at":"2026-04-10T08:55:05.762109","excluded":0,"excluded_reason":null,"id":"NER-HB-0005","ldc":"Yes","location":"阿加德兹大区","location_norm":null,"name_en_quality":"ai_translated","project_name":"尼日尔阿加德兹3.321MW柴光互补储能电站项目","project_name_en":"Niger Agadez 3.321MW Hybrid Solar PV and Energy Storage Project","subcategory":"光储"},"events":[{"articles":[{"author":"葛洲坝","content":"当地时间7月17日，\n中国能建葛洲坝集团\n与\n尼日尔国家电力公司\n签署\n尼日尔阿加德兹柴光互补储能电站项目商务合同\n。这是葛洲坝集团继坎大吉水电站1标项目后，在尼日尔斩获的又一民生工程，实现了公司在尼日尔市场的滚动发展。该项目也是公司西北非区域总部成立后充分发挥市场前移优势签约的新能源现汇项目。\n项目位于距离首都1200公里的阿加德兹大区提米亚、迪尔库和比尔玛等5座城镇，未来将拓展至17座城镇，工程内容包括2876kWc光伏发电系统和4345kWh的储能系统以及相关附属设施的设计、供货和安装。本项目由世界银行融资，为尼日尔乡村电气化框架项目之一。\n项目工期18个月\n，建成后将改变上述城镇无电现状，提高清洁能源利用率，助力沙漠地区减贫。","content_sha256":"2d22e5a2be89320dc412f9a3023bd115428b9a760ee06131368b1f5063421887","id":20888,"publish_date":"2020-07-18 15:30:30","title":"葛洲坝签署尼日尔阿加德兹柴光互补储能电站现汇项目","title_sha256":"d21429698ff9ecd1bd70e962a8d2abb89f9d4a71d83a76fcb4482de7d94d6fb4","url":"https://news.goalfore.cn/topstories/detail/15005.html"}],"event":{"additional_remarks":"","canonical_id":"NER-HB-0005","capacity_details":"PV: 2.876MWc, BESS: 4.345kWh","capacity_mw":3.321,"capacity_mw_raw":"3.321","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-04-10T08:55:05.766429","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"信贷融资","financing_model_details":"世界银行融资","id":"NER-HB-0005-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://it.enfsolar.com/news/19223/%E4%B8%AD%E8%85%BE%E5%BE%AE%E7%BD%91%E5%B0%BC%E6%97%A5%E5%B0%94%E9%98%BF%E5%8A%A0%E5%BE%B7%E5%A4%A7%E5%8C%BA%E6%9F%B4%E5%85%89%E5%82%A8%E4%BA%92%E8%A1%A5%E7%94%B5%E7%AB%99%E9%A1%B9%E7%9B%AE%E6%88%90%E5%8A%9F\"]","official_website_links":"[]","planned_complete_date":"","plann