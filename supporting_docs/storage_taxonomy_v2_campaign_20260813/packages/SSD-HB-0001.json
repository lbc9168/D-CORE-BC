{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"南苏丹","country_iso":"SSD","created_at":"2026-03-23T10:02:49.348756","excluded":0,"excluded_reason":null,"id":"SSD-HB-0001","ldc":"Yes","location":"朱巴","location_norm":null,"name_en_quality":"ai_translated","project_name":"南苏丹朱巴60兆瓦综合能源电站项目","project_name_en":"South Sudan Juba 60MW Hybrid Power Station Project","subcategory":"光储"},"events":[{"articles":[{"author":"水电五局","content":"12月13日，中国电建授权水电五局市场开发的中国水电南苏丹代表处与南苏丹能源与大坝部正式签约南苏丹朱巴60兆瓦综合能源电站项目。\n该项目位于南苏丹首都朱巴，现场地势平坦，覆盖低矮灌木和植被，整体开发条件良好。总面积约0.947平方公里，工作范围包括设计、采购、制造、建造、安装、架设、调试、测试一座60兆瓦地面光伏电站、一座50兆瓦柴油发电机组、一座30兆瓦/60兆瓦时化学储能电站，以及新建一条25公里33千伏双回输电线路，连接至朱巴城网33千伏变电站。工期24个月。\n南苏丹目前居民用电价格为0.44美元一度电，该项目的签约和实施，将极大缓解南苏丹朱巴市居民用电需求和满足朱巴市民降低电价的迫切愿望。项目的成功签约，进一步提升了公司在南苏丹的影响力，不仅体现了业主部门对公司的深切认可与高度信任，也进一步增强了水电五局坚定南苏丹市场的信心。","content_sha256":"08a32fb27d88d5f7bb9f89a66d589a6156d43024cdd432b8e353e8810800dde5","id":5405,"publish_date":"2024-12-19 07:30:16","title":"水电五局签约南苏丹60兆瓦综合能源电站项目","title_sha256":"09ff852892cad3f97b754a4fd7e3d2f986d17c3cfc4b1498eb0df5aeae4b3922","url":"https://news.goalfore.cn/topstories/detail/76367.html"}],"event":{"additional_remarks":"","canonical_id":"SSD-HB-0001","capacity_details":"PV: 60MW, Diesel: 50MW, BESS: 30MW/60MWh","capacity_mw":140.0,"capacity_mw_raw":"140","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:02:49.348867","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"SSD-HB-0001-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.powerchina.cn/WZWSREL2NvbDc0NDkvYXJ0LzIwMjQvYXJ0Xzc0NDlfMjA1MTAyOC5odG1s\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"南苏丹能源与大坝部","project_developer_