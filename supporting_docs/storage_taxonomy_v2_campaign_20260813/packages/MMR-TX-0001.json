{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"输变电建设","country":"缅甸","country_iso":"MMR","created_at":"2026-03-23T09:45:48.245827","excluded":0,"excluded_reason":null,"id":"MMR-TX-0001","ldc":"Yes","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"缅甸内燃机车电池电力化改造项目","project_name_en":"Myanmar Diesel Locomotive Battery Electrification Retrofit Project","subcategory":null},"events":[{"articles":[{"author":"中国二重","content":"中标柬埔寨100/200MWh\n构网型储能项目\n近日，国机重装所属中国重机中标柬埔寨国家电力公司（简称“EDC”）构网型储能EPC项目，标志公司在“一带一路”新能源储能领域实现重大突破。\n该项目是柬埔寨茶胶省重点工程，规模达100/200MWh，采用先进的构网型技术。中国重机将为EDC提供包括电池储能系统设计、设备采购、安装施工、系统调试及运维服务等全链条工程总包业务。项目建成投产后，将显著提升当地电网调频调压能力，增强区域电网稳定性，保障电力供应安全，为柬埔寨能源体系建设和深化中柬能源合作作出积极贡献。\n中标缅甸内燃机车\n电池电力化改造项目\n近日，国机重装所属中国重机中标缅甸铁路局内燃机车电池电力化改造项目，标志公司在海外轨道交通新能源改造领域实现重要突破。\n该项目是缅甸铁路局重点工程，中国重机将为用户提供涵盖车辆设计、设备采购、系统改造、安装调试及运维服务等工程业务，完成现有机车、车厢电气化改造，全面提升车辆性能与运营效率，将其打造成为缅甸铁路电气化改造标杆工程，为进一步推动当地交通领域智能化、绿色化发展，拓展东南亚其他国别市场具有广泛推广意义。","content_sha256":"843e4a10aef3a1c20f1558db7de14e2eeb3205e34e4b20d4d76fe8e49e7cbfa1","id":2223,"publish_date":"2025-08-29 12:00:04","title":"中国重机海外市场连中两标","title_sha256":"d27c1e031a2ea38f963035ad1d419d7c9f4a005b45c071aa4c248ffcf3cafa3b","url":"https://news.goalfore.cn/topstories/detail/86921.html"}],"event":{"additional_remarks":"","canonical_id":"MMR-TX-0001","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:45:48.245959","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"MMR-TX-0001-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.chmc.cc/cn_news_center/gsxw/202511/t20251105_591089.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"缅甸铁路局","project_developer_en":"Myanmar Railways","project_stage":"中标","project_summary":"中国重机中标缅甸内燃机车电池电力化改造项目。该项目是缅甸铁路局的重点工程，旨在提升机车性能与运营效率，推动当地交通领域智能化、绿色化发展。中国重机将负责车辆设计、设备采购、系统改造等工程业务。","publish_date":"2025-08-29 12:00:04","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/86921.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"MMR-TX-0001","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["storage_text_signal"]}
