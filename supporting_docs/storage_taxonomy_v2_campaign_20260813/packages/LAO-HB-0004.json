{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"老挝","country_iso":"LAO","created_at":"2026-03-23T10:32:54.115867","excluded":0,"excluded_reason":null,"id":"LAO-HB-0004","ldc":"Yes","location":"万象","location_norm":"万象省","name_en_quality":"ai_translated","project_name":"老挝30万千瓦电站项目","project_name_en":"Laos 300MW Power Plant Project","subcategory":null},"events":[{"articles":[{"author":"亚钾国际","content":"12月27日下午，经过老挝总理府批准授权，亚钾国际与老挝计划投资部于老挝首都万象正式签署了30万千瓦电站项目可行性研究谅解备忘录，标志着亚钾国际电站项目正式获批落地。电站项目的获批，对公司发展意义重大。\n保持稳定低廉电价\n实现公司降本增效目标\n随着亚钾国际钾肥产能规模的快速扩建，对电力能源的价格稳定、低廉提出了更高需求。本次公司与老挝政府合力升级电力能源系统，建设电站项目，将有力保持公司用电电价稳定，降低公司生产运营成本，实现降本增效的核心目标。\n以能源成本优势吸引优质投资\n加速打造钾/非钾产业集群\n本次签约的30万千瓦电站项目，是亚钾产业园整体电力能源配套的重大升级，低廉、稳定的电价，将有力降低投资企业的能源成本，以能源优势吸引优质投资，汇聚发展动力，释放产业价值的聚合潜力，为打造钾与非钾产业集群按下加速键。\n光伏发电项目同步获批\n能源成本优势更加显著\n同日，亚钾国际3万千瓦光伏发电项目也同时获得了老挝政府的批准，签署了项目备忘录。光伏发电作为清洁低碳能源发电方式，是各类电力能源成本最低之一，将进一步降低公司用电成本，增强企业经济效益。\n30万千瓦电站项目与3万千瓦光伏发电项目备忘录签署，体现了老挝政府对亚钾国际的高度认可和大力支持。作为老挝首个热电联产项目，电站项目生产的蒸汽能够满足公司项目的热能需求，进一步降低综合能源成本，提升企业整体盈利水平。","content_sha256":"c5f164f9523cfc71f9e0f31a0935d16b412fdbf83f2850f1075d630edc4b863d","id":10252,"publish_date":"2023-12-29 19:00:38","title":"亚钾国际与老挝计划投资部正式签署30万千瓦电站项目可行性研究谅解备忘录","title_sha256":"c363d6b49467a0f118d208c46ff250e3a23fd478c299fcd190537594cafbeb47","url":"https://news.goalfore.cn/topstories/detail/57016.html"}],"event":{"additional_remarks":"","canonical_id":"LAO-HB-0004","capacity_details":"Thermal Power: 300MW, PV: 30MW","capacity_mw":330.0,"capacity_mw_raw":"330","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:32:54.116098","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"LAO-HB-0004-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://wap.eastmoney.com/a/202312292947826170.html\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"亚钾国际","project_developer_en":"Asia Pacific Potash Corporation","project_stage":"签约","project_summary":"中国企业亚钾国际在老挝计划投资部签署了30万千瓦电站项目可行性研究谅解备忘录，该项目旨在为公司提供稳定低廉的电力，并加速打造钾/非钾产业集群。同时，3万千瓦光伏发电项目也获得批准。","publish_date":"2023-12-29 19:00:38","pv_capacity_mw":30.0,"source_links":"[\"https://news.goalfore.cn/topstories/detail/57016.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"LAO-HB-0004","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
