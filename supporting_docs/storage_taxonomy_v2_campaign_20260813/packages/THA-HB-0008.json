{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"泰国","country_iso":"THA","created_at":"2026-03-23T10:30:59.387430","excluded":0,"excluded_reason":null,"id":"THA-HB-0008","ldc":"No","location":"沙缴府","location_norm":null,"name_en_quality":"ai_translated","project_name":"泰国沙缴府400吨/日垃圾发电项目","project_name_en":"Thailand Sa Kaeo Province 400t/day Waste-to-Energy Project","subcategory":null},"events":[{"articles":[{"author":"中国能建湖南院","content":"1月15日，中国能建中电工程湖南院与安徽二联合体同业主TGE公司成功签署泰国垃圾发电项目EPC合同。公司董事长、党委书记李屹立出席签约仪式。\n签约仪式上，李屹立表达了对项目成功签约的祝贺，对各方的工作给予高度赞扬，表示本项目与公司国际优先战略高度契合，各方在本项目上的利益趋同、目标一致。公司高度重视本项目，在后续执行阶段，将配置优势资源，加强与各方的沟通，精诚合作，把本项目做成泰国市场标杆工程。\n本项目位于泰国沙缴府，新建一座处理量400t/天的垃圾焚烧电厂。项目建成后，将极大提升当地垃圾无害化处理能力，在提高当地环境保护水平、提升生活品质、科普宣传等方面具有重大意义。\n本次签约，实现了公司在泰国市场的重大突破，是公司持续深耕泰国市场的结果，开启了与集团兄弟单位携手并进的新征程。\n国际集团东南亚区域总部、驻泰机构；安徽二副总经理王诚，国际部门、中安泰公司；公司董事会秘书刘建，国际部、能源工程公司（建筑市政公司）、新能源工程公司、财务与产权管理部、法务与合规部等部门负责人及相关人员参加签约仪式。","content_sha256":"8cbf0ad8d77fd7c04f52527a0a3a1401faff3ef732aedb69aac8b552a9e40749","id":9925,"publish_date":"2024-01-18 15:55:02","title":"中国能建中电工程湖南院与安徽二联合体同业主TGE公司成功签署泰国垃圾发电项目EPC合同","title_sha256":"3e7874627af1adafd4701378944f0cb2db16ccd870e6810c3005586baab60ea3","url":"https://news.goalfore.cn/topstories/detail/58279.html"}],"event":{"additional_remarks":"","canonical_id":"THA-HB-0008","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:30:59.387966","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"THA-HB-0008-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.solidwaste.com.cn/news/349347.html\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"TGE公司","project_developer_en":"TGE Gas Engineering","project_stage":"签约","project_summary":"中国能建中电工程湖南院与安徽二联合体与业主TGE公司签署了泰国沙缴府垃圾发电项目EPC合同。该项目将新建一座日处理量400吨的垃圾焚烧电厂，是中国能建在泰国市场的重大突破。","publish_date":"2024-01-18 15:55:02","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/58279.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"THA-HB-0008","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
