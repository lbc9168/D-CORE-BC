{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"储能","country":"塞内加尔","country_iso":"SEN","created_at":"2026-03-23T09:48:39.921099","excluded":0,"excluded_reason":null,"id":"SEN-ES-0001","ldc":"Yes","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"塞内加尔30兆瓦/60兆瓦时储能黑启动EPC项目","project_name_en":"Senegal 30MW/60MWh Energy Storage Black Start EPC Project","subcategory":null},"events":[{"articles":[{"author":"江西电建","content":"7月15日，塞内加尔国家电力公司代表团、英飞尼姆国际有限公司董事长吕克一行到访江西电建公司，与公司党委书记、董事长邹胜萍等就推进塞内加尔能源项目合作、电力市场高质量发展进行座谈交流，并签署谅解备忘录。\n会上，双方分别详细介绍各自生产经营、业务布局等情况，聚焦塞内加尔30兆瓦/60兆瓦时储能黑启动EPC项目展开洽谈，就项目建设技术路径、实施细节等进行探讨。针对塞内加尔代表团提出的电网调峰调频及黑启动等核心需求，公司详细展示储能领域成熟技术与丰富项目经验，表示可提供一揽子、差异化的能源问题解决方案，得到塞内加尔代表团高度认可。\n双方一致认为，塞内加尔电力行业发展前景广阔，双方合作空间巨大，希望能加快推进该项目前期工作，力争早日落地见效，并以此为契机继续深化合作，共同推动塞内加尔能源转型。随后公司与塞内加尔国家电力公司签署塞内加尔30兆瓦/60兆瓦时储能黑启动EPC项目、塞内加尔国家后续电力发展谅解备忘录。\n公司总经理助理，相关部门、单位人员参加座谈。","content_sha256":"118012bbc044363cc13e5117a7a7850a58e002ca63f004a26a9026f91cace516","id":2794,"publish_date":"2025-07-17 09:21:02","title":"江西电建公司与塞内加尔国家电力公司进行座谈交流并签署谅解备忘录","title_sha256":"5dbb6bc1d0f5a3a14867744745dbc720b0af11cc2c17f9dbaaae302cbbfee2fd","url":"https://news.goalfore.cn/topstories/detail/85256.html"}],"event":{"additional_remarks":"","canonical_id":"SEN-ES-0001","capacity_details":"BESS: 30MW/60MWh","capacity_mw":30.0,"capacity_mw_raw":"30","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:48:39.921397","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"SEN-ES-0001-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://jepcc.powerchina.cn/col/col13506/art/2025/art_0e1dc10bf60046269a5d268ccbbe4a8a.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_val