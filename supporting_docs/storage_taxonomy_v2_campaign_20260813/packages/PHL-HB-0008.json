{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"菲律宾","country_iso":"PHL","created_at":"2026-03-23T10:06:34.307526","excluded":0,"excluded_reason":null,"id":"PHL-HB-0008","ldc":"No","location":"达沃地区","location_norm":"达沃","name_en_quality":"ai_translated","project_name":"菲律宾达沃地区塔巴罗斯隧洞设计建造项目","project_name_en":"Philippines Davao Tabarros Tunnel Design and Construction Project","subcategory":null},"events":[{"articles":[{"author":"中水电","content":"近日，中水电菲律宾分公司成功签约塔巴罗斯隧洞设计建造项目（以下简称“项目”）。\n项目位于菲律宾达沃地区，计划工期521天，工程主要内容是建设一条直径5.06米、全长约3千米的排水和通风隧洞，计划采用双护盾全断面硬岩隧洞掘进机（TBM）施工。这也是继安嘎特供水5号隧洞、凯萨卡供水隧洞项目后，公司在菲中标的又一隧洞工程。\n近年来，菲律宾分公司凭借丰富的隧洞开挖经验和设备技术优势，获得了在建项目业主的好评与信任。该项目的成功签约，标志着菲律宾达沃项目群管理实践初见成效，有力助推区域规模化经营向好发展。","content_sha256":"f77b13a9f4922d48ff64dc6161f1b150594232766397530411b2ef31f1d7be20","id":5950,"publish_date":"2024-11-14 13:50:04","title":"中水电菲律宾分公司成功签约菲律宾塔巴罗斯隧洞设计建造项目","title_sha256":"eb8d31d58ff988ce325c19fc4936d7b2cf9e187a00bec991d85b5b9d1a5008ad","url":"https://news.goalfore.cn/topstories/detail/74648.html"}],"event":{"additional_remarks":"","canonical_id":"PHL-HB-0008","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:06:34.307625","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"PHL-HB-0008-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.cwe.cn/xwzx/jydt/202411/t20241122_268921.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"中水电菲律宾分公司","project_developer_en":"China Water Resources and Hydropower Philippines Branch","project_stage":"签约","project_summary":"中国水电菲律宾分公司在菲律宾达沃地区签约了塔巴罗斯隧洞设计建造项目。该项目将建设一条排水和通风隧洞，采用TBM施工。这是该公司在菲律宾中标的又一隧洞工程。","publish_date":"2024-11-14 13:50:04","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/74648.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"PHL-HB-0008","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
