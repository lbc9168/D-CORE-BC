{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"泰国","country_iso":"THA","created_at":"2026-04-10T08:54:43.503414","excluded":0,"excluded_reason":null,"id":"THA-HB-0016","ldc":"No","location":"春蓬府","location_norm":null,"name_en_quality":"ai_translated","project_name":"泰国春蓬府20MW混合电站项目","project_name_en":"Thailand Chumphon 20MW Hybrid Power Plant Project","subcategory":null},"events":[{"articles":[{"author":"葛洲坝","content":"7月27日，\n中国能建葛洲坝国际公司\n与\nTTC公司\n在泰国首都曼谷签署\n一期20MW混合电站项目EPC合同协议\n，实现了泰国市场多能互补项目领域新突破，助力公司多能互补混合发电业务做强做优。\n项目位于泰国南部春蓬府帕蒂奥区，主要工程内容为一座20MW混合电站项目的设计、采购、施工、安装、调试和试运行。\n当前，可再生能源已经成为能源发展战略的重要组成部分以及能源转型的重要发展方向。根据可再生能源应用的不同领域，电力系统建设正在发生结构性转变，可再生能源发电已开始成为能源建设的重要方向。生物质发电是可再生能源发电的一种，是目前生物质能应用方式中最普遍、最有效的方法之一。\n泰国广泛种植适用于生物质发电的农作物稻米、甘蔗等,而这些农作物的加工废弃物稻秸叶等非常适合用作生物质发电的原料。\n为此,泰国政府制定了第一个5年计划(2020至2024年社区电厂推进计划),目标总装机容量为1,933MW，其中2020-2021年将建设总装机容量为700MW的社区电厂，旨在实现社区电力自给自足，拉动社区经济发展。该项目是泰国社区电厂推进计划的重要组成部分，建成后每年平均发电1.05至1.07亿千瓦时,将有效缓解当地社区缺电现状，为当地基础设施改善、产业发展等提供稳定可靠的电力支撑，拉动社区经济可持续发展。","content_sha256":"7d80316e468efa61f48a452b502dbd1c6ab62e224c37f2448c6952570133f4bf","id":20835,"publish_date":"2020-07-27 13:30:41","title":"葛洲坝签约泰国一期20MW混合电站项目","title_sha256":"647152d77dcce26cf7bb0a86e8622c8649fb1b38c703721a2e35493982307a23","url":"https://news.goalfore.cn/topstories/detail/15117.html"}],"event":{"additional_remarks":"","canonical_id":"THA-HB-0016","capacity_details":"混合电站","capacity_mw":20.0,"capacity_mw_raw":"20","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-04-10T08:54:43.504865","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"THA-HB-0016-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.seetao.com/details/32734.html\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"TTC公司","project_developer_en":"TTC Company","project_stage":"签约","project_summary":"中国能建葛洲坝国际公司与TTC公司在泰国曼谷签署了20MW混合电站项目EPC合同。该项目位于泰国南部春蓬府，是泰国社区电厂推进计划的一部分，旨在缓解当地电力短缺并促进经济发展。","publish_date":"2020-07-27 13:30:41","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/15117.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"THA-HB-0016","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
