{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"No","category":"储能","country":"澳大利亚","country_iso":"AUS","created_at":"2026-04-10T09:07:24.610587","excluded":0,"excluded_reason":null,"id":"AUS-ES-0019","ldc":"No","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"澳大利亚户用储能项目","project_name_en":"Australia Residential Energy Storage Project","subcategory":null},"events":[{"articles":[{"author":"","content":"11月13日，\n澳大利亚GTL集团\n董事长Lucas一行访问\n中国能建江苏院\n，双方签订\n第一批、第二批户用储能项目EP合同\n，并就项目实施细节进行交流讨论。中信保江苏公司融资政策专家参加会谈。\n澳大利亚是世界上风光资源最丰富的国家之一，风电、光伏装机比例较高，但由于特殊的人口分布和电网架构，电网稳定性较差，对发展储能业务的需求非常迫切。\n近年来，随着南澳推出高额政府补贴鼓励政策，澳大利亚储能业务呈井喷式增长。\n江苏院依托与中信保江苏公司联合牵头的江苏电力“走出去”联盟，通过合法、合规、灵活的融资模式，快速把握市场机会，短短五个月内完成了各项尽职调查、市场资源整合、交易结构设计和抵押担保手续，与澳大利亚最大的储能零售安装商GTL集团独家议标达成户用储能一揽子项目设计、供货意向。\n同时，江苏院通过聘请境内外律师专家，邀请中信保开展交易对手商业风险评估以及实地踏勘等多种方式，确保业务合规性，并派出专人就抵押方式、资产评估、境内外支付和外管税收风险等做了大量财务风险控制工作，为项目的顺利推进保驾护航。","content_sha256":"476fcf3ea0b54f16dce22ec3145eb309315b8b7ebdf1b22eaba8ca4eb7be3588","id":22584,"publish_date":"2019-11-20 18:17:26","title":"中国能建江苏院与澳大利亚GTL集团签订户用储能项目EP合同","title_sha256":"d13a6e69ffec1576374618cabda02c95d20e4a08822f710d0cc716980efc024d","url":"https://news.goalfore.cn/topstories/detail/11907.html"}],"event":{"additional_remarks":"","canonical_id":"AUS-ES-0019","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-04-10T09:07:24.614072","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"AUS-ES-0019-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.esresearch.com.cn/report/info/?id=2320\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"澳大利亚GTL集团","project_developer_en":"GTL Group Australia","project_stage":"签约","project_summary":"中国能建江苏院与澳大利亚GTL集团签订了第一批、第二批户用储能项目的EP合同。该项目旨在解决澳大利亚电网稳定性差的问题，并利用当地丰富的风光资源。具体装机容量未在新闻中提及。","publish_date":"2019-11-20 18:17:26","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/11907.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"AUS-ES-0019","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["storage_text_signal"]}
