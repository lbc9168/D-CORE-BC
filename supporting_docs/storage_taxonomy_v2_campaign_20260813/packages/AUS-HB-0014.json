{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"No","category":"综合能源","country":"澳大利亚","country_iso":"AUS","created_at":"2026-03-23T11:04:59.904210","excluded":0,"excluded_reason":null,"id":"AUS-HB-0014","ldc":"No","location":"南澳大利亚州","location_norm":null,"name_en_quality":"ai_translated","project_name":"澳大利亚APSP 180MWac光储一体化项目","project_name_en":"Australia APSP 180MWac Solar PV and Battery Storage Project","subcategory":"光储"},"events":[{"articles":[{"author":"中电工程国际公司","content":"9月29日，中国电力建设工程咨询有限公司与澳大利亚GREEN GOLD ENERGY（GGE）公司通过视频连线方式成功签署了澳大利亚APSP180MWac光储一体化项目EPC合同。\n该项目位于南澳大利亚州平原镇，距离南澳州首府阿德莱德市约129公里，项目装机容量为180MWac。\nAPSP光储一体化项目是咨询公司在澳大利亚首个新能源项目，是咨询公司国际业务成功开辟越南市场后，首次进入发达国家高端市场，实现了海外业务市场新突破。是咨询公司以中国能建《若干意见》为统领，坚定实施“1466”战略，积极践行“一体两翼”海外优先发展战略的具体成果。APSP光储一体化项目成功开发，标志着咨询公司国际市场开发能力的提升和市场多元化成功布局，为咨询公司国际业务的高质量发展打下坚实基础。","content_sha256":"bf9a18c0f736ded76f655c42c82b3d98faecd05571ce09bcfd5ced0a44d92e58","id":15213,"publish_date":"2022-10-01 11:32:01","title":"中电工程国际签约澳大利亚APSP180MWac光储一体化项目","title_sha256":"39f1c2fda94c021ba0a17ba78a9d0f5092ad1091ae15bee2d42f571da3a9557d","url":"https://news.goalfore.cn/topstories/detail/32856.html"}],"event":{"additional_remarks":"","canonical_id":"AUS-HB-0014","capacity_details":"PV: 180MWac","capacity_mw":180.0,"capacity_mw_raw":"180","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T11:04:59.905539","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"AUS-HB-0014-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.cnesa.org/information/detail/?column_id=58&id=1259\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"GREEN GOLD ENERGY（GGE）公司","project_developer_en":"GREEN GOLD ENERGY (GGE) Company"