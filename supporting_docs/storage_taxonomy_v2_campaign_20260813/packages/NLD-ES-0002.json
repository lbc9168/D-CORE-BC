{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"No","category":"储能","country":"荷兰","country_iso":"NLD","created_at":"2026-04-12T23:53:43.621885","excluded":0,"excluded_reason":null,"id":"NLD-ES-0002","ldc":"No","location":"阿姆斯特丹","location_norm":null,"name_en_quality":"ai_translated","project_name":"荷兰苏美达辉伦储能示范项目","project_name_en":"Netherlands SUMEC-PHONO Energy Storage Demonstration Project","subcategory":null},"events":[{"articles":[{"author":"苏美达能源","content":"新突破新落地\n苏美达辉伦储能项目签约荷兰\n日前，在荷兰阿姆斯特丹举行的SolarSolution 2026展会期间，苏美达能源旗下辉伦太阳能（PHONO）与当地资深储能EPC商及专业能源供应商签署合作协议，共同推动苏美达辉伦储能新品在荷兰的示范项目落地。此次合作标志着PHONO储能产品在欧洲市场的布局再添新篇，为深耕荷兰储能市场奠定基础。\n该项目将采用苏美达辉伦户外储能系统，配备iBMS智能电池管理技术，具备即插即用、模块化扩展、安全长效等特点。系统可灵活适配户用及工商业场景，通过智能化能量管理提升能源利用效率，为用户提供可靠、经济的储能解决方案。\n作为苏美达辉伦“发、储、用、安”一体化战略的重要一环，储能新品自推出以来备受关注。此次携手荷兰本地专业伙伴推动项目落地，是对产品技术实力与系统集成能力的有效验证，也为后续在欧洲市场的进一步拓展积累实践经验。\n荷兰是欧洲能源转型的先锋市场，光伏及储能需求持续增长。苏美达辉伦储能新品落地荷兰，是公司深耕欧洲市场的重要一步，也将“创新、可靠、可持续”的品牌承诺转化为实际成果。\n未来，苏美达辉伦将持续加大储能技术研发与系统集成创新，携手全球合作伙伴，共同推动可再生能源产业高质量发展。","content_sha256":"6f4d0f2b1d21e7018e598b7ec51c726d548f93b64363fa74d1b175c7ca55ae21","id":26334,"publish_date":"2026-03-16 10:18:05","title":"苏美达辉伦储能项目签约荷兰","title_sha256":"35233be654815efbcaed053c7045185a585ab56cd46851ce77d7c469c25e567e","url":"https://news.goalfore.cn/topstories/detail/93420.html"}],"event":{"additional_remarks":"","canonical_id":"NLD-ES-0002","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-04-12T23:53:43.624463","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"NLD-ES-0002-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.esresearch.com.cn/project/\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":nu