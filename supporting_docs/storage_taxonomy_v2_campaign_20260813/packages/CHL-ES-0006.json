{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"储能","country":"智利","country_iso":"CHL","created_at":"2026-03-23T10:17:30.775303","excluded":0,"excluded_reason":null,"id":"CHL-ES-0006","ldc":"No","location":"阿塔卡马沙漠","location_norm":null,"name_en_quality":"ai_translated","project_name":"智利BESS del Desierto 880MWh储能项目","project_name_en":"Chile BESS del Desierto 880MWh Energy Storage Project","subcategory":null},"events":[{"articles":[{"author":"华桥研究院","content":"近日，阳光电源与拉美最大独立发电商之一Atlas Renewable Energy达成供货协议，拉美规模最大的独立储能项目智利BESS del Desierto 880MWh电站将全部采用阳光电源PowerTitan液冷储能系统，通过领先的储能解决方案能有效解决智利北部限电问题，增强地区能源可靠性，助力实现智利2050年100%清洁能源目标。\n该项目位于智利阿塔卡马沙漠，受制于当地有限的电力传输条件，其丰富的光电资源，难以输送到1500公里外的核心用电区域。Atlas在智利建设首个大型独立储能电站，在电力传输受阻时将多余的光伏电能存储，在电网有能力负载时并入，让地区用电更灵活、可持续。\n据预计，该项目建成后每年可向智利电网额外注入约280GWh电能，将有效缓解当地的用电短缺。","content_sha256":"bb7f9203ba588761f2e52774dd6605380cb7a120c1e4aad873cd6826ca194c01","id":7816,"publish_date":"2024-07-03 11:17:02","title":"阳光电源携手Atlas建设拉美最大独立储能电站","title_sha256":"1e1fffde9f09a1924223105e53e38c6d56e6e11fa8e48706e6357cc0be5ae012","url":"https://news.goalfore.cn/topstories/detail/67856.html"}],"event":{"additional_remarks":"","canonical_id":"CHL-ES-0006","capacity_details":"BESS: 880MWh","capacity_mw":880.0,"capacity_mw_raw":"880","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:17:30.775566","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"CHL-ES-0006-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://cn.sungrowpower.com/news/1552.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"Atlas Renewable Energy","project_developer_en":"Atlas Renewable Energy","project_stage":"在建","project_summary":