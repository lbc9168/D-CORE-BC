{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"安哥拉","country_iso":"AGO","created_at":"2026-04-10T08:30:26.062128","excluded":0,"excluded_reason":null,"id":"AGO-HB-0004","ldc":"Yes","location":"9省11市","location_norm":null,"name_en_quality":"ai_translated","project_name":"安哥拉柴光互补项目","project_name_en":"Angola Diesel-Solar Hybrid Project","subcategory":null},"events":[{"articles":[{"author":"东方国际微讯","content":"11月26日，\n安哥拉柴光互补项目的最后三个电站(LUENA、SAURIMO、KUITO电站)完成最终移交\n，标志着安哥拉柴光互补项目实现圆满收官。\n“\n安哥拉柴光互补项目包括8座柴光互补电站和3座20MW柴油机电站，\n覆盖安哥拉9省11市，是东方电气在非洲大陆执行的首个EPC项目。\n自2017年6月合同生效以来，在项目部全体成员的齐心协力下，8个混合动力电站于2020年10月21日前分别获得了最终移交证书。剩余3个柴油机电站的移交，受到了突如其来的新冠肺炎疫情的严重冲击，项目部驻现场人员克服疫情所造成的严重影响，以饱满的热情和高昂的斗志，不怕困难与艰险，逆行抗疫，长期坚守现场，实现了3个柴油机电站的最终移交并获得证书。\n“\n安哥拉柴光互补项目获得全部11座电站的最终移交证书，不仅是对4年多来为此付出心血的全体项目成员的最好回报，也为东方国际在非洲执行类似项目积累了宝贵的经验，为公司进一步在非洲发展打下了良好的基础。","content_sha256":"c595b282f38853d7fed6667d708c03cd1b61b68161dce5d0086732bf60cf0b2a","id":17526,"publish_date":"2021-12-03 13:40:02","title":"安哥拉项目3座柴油机电站获得“最终移交证书”","title_sha256":"388c6a55bd1c15079fbf20f6cdab2d6358f95f2503c4f6d7f2a60775a9d5e48a","url":"https://news.goalfore.cn/topstories/detail/24354.html"}],"event":{"additional_remarks":"","canonical_id":"AGO-HB-0004","capacity_details":"3座20MW柴油机电站","capacity_mw":3.0,"capacity_mw_raw":"3*20","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-04-10T08:30:26.065518","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"AGO-HB-0004-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.dec-ltd.cn/info/1399/11398.htm\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"中国东方电气集团有限公司","project_developer_en":"DEC","project_stage":"投入运营","proj