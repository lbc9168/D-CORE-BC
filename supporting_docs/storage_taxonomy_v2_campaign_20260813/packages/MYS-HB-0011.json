{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"马来西亚","country_iso":"MYS","created_at":"2026-03-23T10:26:56.267552","excluded":0,"excluded_reason":null,"id":"MYS-HB-0011","ldc":"No","location":"登嘉楼州","location_norm":null,"name_en_quality":"ai_translated","project_name":"马来西亚登嘉楼州帕卡200MW绿氢一体化项目","project_name_en":"Malaysia 200MW Green Hydrogen Integrated Project (Paka, Terengganu)","subcategory":null},"events":[{"articles":[{"author":"能建国际集团","content":"3月9日，中国能建国际集团与江苏院组成的联营体与马来西亚Nova RE Suria Sdn Bha公司签署马来西亚登嘉楼州帕卡200MW绿氢一体化项目EPC框架协议，中国能建江苏院和华北院组成的联营体签署了项目设计咨询合同。这是中国能建锚定战略性新兴产业和未来产业，发挥全产业链优势，积极布局全球绿色氢能产业的重要成果，将为马来西亚清洁能源转型注入新动力。\n签约现场\n项目位于马来西亚登嘉楼州，计划设计并建设200MW绿氢工厂及配套30MW光伏电站。\n马来西亚第12个五年发展计划指出，新兴可再生能源和低碳能源在马来西亚能源转型中扮演重要角色。2023年马来西亚科学技术和创新部（MOSTI）发布了氢能经济和技术路线图。该项目签约将进一步推动马来西亚氢能经济发展和能源结构转型。\n中国能建国际集团副总裁张德良；国际集团东南亚区域总部、马来西亚有限公司，江苏院、华北院相关单位负责人参加签约仪式。","content_sha256":"f519dc26a69aa6c04f7a747679fb349a4d28483e36b61fc5583f22c40cc5bda4","id":9231,"publish_date":"2024-03-10 07:30:39","title":"签约！马来西亚登嘉楼州帕卡200MW绿氢一体化项目","title_sha256":"fbc789450058ecbb906797f7370db7a8efa92571d68c3da9f686f03025edd4bd","url":"https://news.goalfore.cn/topstories/detail/61680.html"}],"event":{"additional_remarks":"","canonical_id":"MYS-HB-0011","capacity_details":"Green Hydrogen: 200MW, PV: 30MW","capacity_mw":230.0,"capacity_mw_raw":"230","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:26:56.267974","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"MYS-HB-0011-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.ceec.net.cn/art/2024/3/12/art_11019_2530783.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"Nova R