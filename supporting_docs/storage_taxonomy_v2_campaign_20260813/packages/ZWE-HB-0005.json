{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"津巴布韦","country_iso":"ZWE","created_at":"2026-03-23T10:33:28.839049","excluded":0,"excluded_reason":null,"id":"ZWE-HB-0005","ldc":"No","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"津巴布韦270MW可再生能源发电项目","project_name_en":"Zimbabwe 270MW Renewable Energy Power Project","subcategory":null},"events":[{"articles":[{"author":"青山实业","content":"12月20日，浙江鼎森控股有限公司董事长陈上松与津巴布韦电力局董事会主席尕塔博士在电力局董事会高层的见证下签署能源谅解备忘录。鼎森控股将在电力局的支持下完成三座利用可再生能源的发电厂，包括鼎森旗下铬铁冶炼厂配套的100MW光伏发电厂、鼎森钢铁配套的100MW风力发电厂以及70MW余热回收发电厂。\n电力局主席尕塔博士在仪式现场提到：“这份协议有着重要的里程碑意义，鼎森控股旗下公司在津巴布韦用电量达到400MW，其在实现自发电的同时有利于津巴布韦储备更多能源。鼎森钢铁将在非洲大陆生产品质最佳且最实惠的产品，为津巴布韦经济带来质变，其转型绿色能源也响应了全球碳中和的号召。”\n鼎森钢铁董事长许克敏表示：70MW发电厂将于明年一月完成，同时100MW光伏与风力发电项目将在明年启动。鼎森控股与电力局协议的签署将使鼎森更有信心投入建设绿色能源项目，在与津巴布韦关系更进一步的同时，为其他投资者起到模范作用。\n鼎森钢铁将会推动其工业园及其周边的产业建设，解决至少5000当地民众的直接就业问题，结合其上下游产业将带动20000人左右的就业。","content_sha256":"7893217df2b03c26cf78b1483a5e70f748d7372228abc09e6e32f8f88de9d4c3","id":10363,"publish_date":"2023-12-24 11:13:02","title":"鼎森控股与津巴布韦电力局签署电力发展协议","title_sha256":"abd79431d0ce7e1375b965e0efeb6e4d042879f50470b1e8337fab346828dc40","url":"https://news.goalfore.cn/topstories/detail/56534.html"}],"event":{"additional_remarks":"","canonical_id":"ZWE-HB-0005","capacity_details":"PV: 100MW, Wind: 100MW, Waste Heat Recovery: 70MW","capacity_mw":270.0,"capacity_mw_raw":"270","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:33:28.839197","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"ZWE-HB-0005-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"http://dinsonholding.com/qyxw/\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"proje