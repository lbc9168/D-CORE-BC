{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"风电","country":"蒙古国","country_iso":"MNG","created_at":"2026-03-23T10:54:31.350917","excluded":0,"excluded_reason":null,"id":"MNG-WD-0001","ldc":"No","location":"东戈壁省","location_norm":null,"name_en_quality":"ai_translated","project_name":"蒙古国乔伊尔100MW风电项目","project_name_en":"Mongolia Choir 100MW Wind Power Project","subcategory":null},"events":[{"articles":[{"author":"葛洲坝国际","content":"近日，中国能建葛洲坝国际公司与蒙古国AB光伏与风能有限公司签约\n乔伊尔100MW风电项目\n。该项目是\n葛洲坝集团在蒙古国承建的首个风电项目\n，为公司持续开拓蒙古国新能源市场迈出了重要一步。\n签约现场\n乔伊尔100MW风电项目\n位于蒙古国东戈壁省达兰扎尔嘎朗县\n项目工程内容为\n建设总装机容量100MW的风电场\n新建一座110/35kV升压站\n配套一套40MW储能系统\n通过约39.5km的双回路架空线路\n输送至乔伊尔变电站\n项目建成后将缓解蒙古国\n东部、中部电力短缺状况\n满足赛音山达、乔伊尔\n居民和矿区的用电需求\n对促进当地经济和社会发展具有重要意义\n近年来\n中国能建葛洲坝国际公司深耕蒙古国别\n充分发挥自身经营优势\n探索蒙古新能源开发的新模式\n积极开拓业务增长极\n公司将持续为当地\n基础设施建设和经济社会发展贡献力量\n为中蒙友谊谱写新的篇章","content_sha256":"46b8d9eb8d4725ba44bcf713cb9d8b0861555e841fb27960fcc8c67c63c4b0ff","id":13393,"publish_date":"2023-05-19 15:40:10","title":"葛洲坝国际公司签约蒙古国乔伊尔100MW风电项目","title_sha256":"1ea59c0a88906b9719832206b6ad5498c4a3bf81b013e050c96b368157aee42d","url":"https://news.goalfore.cn/topstories/detail/40557.html"}],"event":{"additional_remarks":"","canonical_id":"MNG-WD-0001","capacity_details":"Wind Farm: 100MW, Substation: 110/35kV, Energy Storage: 40MW","capacity_mw":100.0,"capacity_mw_raw":"100","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:54:31.351561","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"MNG-WD-0001-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"http://www.gzbgj.ceec.net.cn/art/2023/5/23/art_24873_2518666.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"蒙古国AB光伏与风能有限公司