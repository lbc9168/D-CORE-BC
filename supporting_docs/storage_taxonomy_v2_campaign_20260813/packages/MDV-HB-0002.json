{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"马尔代夫","country_iso":"MDV","created_at":"2026-03-23T09:50:49.220748","excluded":0,"excluded_reason":null,"id":"MDV-HB-0002","ldc":"No","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"马尔代夫综合能源+渔业加工项目","project_name_en":"Maldives Integrated Energy + Fisheries Processing Project","subcategory":null},"events":[{"articles":[{"author":"东方电气","content":"中国出口尼泊尔总容量最大水电项目合同签约生效\n近日，由东方国际签订的尼泊尔上塔莫水电站机电设备供货及安装合同成功生效，标志着中国出口尼泊尔总容量最大水电项目正式启动。上塔莫水电站是由东方国际负责全厂机电设备的供货与安装。电站共装设5台东方电气自主研制的冲击式水轮发电机组，额定水头为433米，转轮直径为2.23米。项目建成后，将显著缓解尼泊尔电力紧缺状况，为千家万户提供清洁高效的电力。\n马尔代夫首个“综合能源+渔业加工”项目签约\n近日，东方国际与马尔代夫渔业及海洋资源部正式签署马尔代夫首个“综合能源+渔业加工”项目合同。该项目分布于马尔代夫的三个岛屿，工作范围包括建设柴光互补电站、海水淡化设施和污水处理系统，以及新建日加工300吨的海产品加工车间，并配套建设7000吨冷冻设施和鱼粉加工车间。项目建成后，将显著提升马尔代夫渔业自主加工能力，有效提高该国渔业产品出口附加值及出口创汇能力，对促进当地经济社会发展有重要意义。","content_sha256":"a0d23f452660d35b8a49691da85dd26bfe2f7d4b146892f61e265b8b11ae9f75","id":3512,"publish_date":"2025-05-26 00:12:03","title":"东方国际签订尼泊尔、马尔代夫项目","title_sha256":"2881f1a6de28462cd5159f560ede277269e714bc0bc68867744fe2c5859b66cc","url":"https://news.goalfore.cn/topstories/detail/83149.html"}],"event":{"additional_remarks":"","canonical_id":"MDV-HB-0002","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:50:49.220921","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"MDV-HB-0002-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"http://m.bhi.com.cn/news-90097953_6_9748\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"东方国际（集团）有限公司","project_developer_en":"Orient International","project_stage":"签约","