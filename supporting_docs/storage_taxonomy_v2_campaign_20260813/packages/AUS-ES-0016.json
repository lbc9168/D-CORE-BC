{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"No","category":"储能","country":"澳大利亚","country_iso":"AUS","created_at":"2026-03-23T10:43:00.957069","excluded":0,"excluded_reason":null,"id":"AUS-ES-0016","ldc":"No","location":"维多利亚州","location_norm":null,"name_en_quality":"ai_translated","project_name":"澳大利亚维多利亚州1MW/2MWh储能项目","project_name_en":"Australia Victoria 1MW/2MWh Energy Storage Project","subcategory":null},"events":[{"articles":[{"author":"中电国际","content":"近日，澳大利亚需求侧1MW/2MWh储能试点项目成功并网。该项目由中电国际所属太平洋水电澳洲公司开发建造，是其投产的第一个兆瓦级电池储能项目。\n项目位置\n项目位于维多利亚州莫宁顿半岛，旨在提高电网稳定性，用以替代所在网点的原有柴油发电机，在每年夏季为当地配电商United Energy提供高峰用电负荷支持，其余时间进行日间能源交易并提供频率控制辅助服务。\n项目建设现场\n中电国际始终坚持创新驱动，大力推进境外新兴产业发展。该项目符合ESG发展理念，具备很好的示范效应，是中电国际境外新兴产业项目开发典型案例。该项目的成功落地有助于太平洋水电澳洲公司掌握储能项目开发过程，并将其商业模式复制到其他与United Energy需求侧储能项目的合作中，为后续开发大规模工业级储能项目积累经验、培养团队，同时也将为集团公司打造境外清洁能源优质供应商品牌、实现“2035一流战略”落地落实贡献力量。","content_sha256":"ffb3b1b6d516bea76bf9d416caf633ca08d5312b55681fdaf150fa8c92dc60fc","id":11667,"publish_date":"2023-10-12 22:25:03","title":"中电国际澳大利亚需求侧储能项目并网成功","title_sha256":"2eb6a154ed809f4a851b1085208aa15cdfa46b25bcaf0d6aaaf39a78059fb9d5","url":"https://news.goalfore.cn/topstories/detail/49101.html"}],"event":{"additional_remarks":"","canonical_id":"AUS-ES-0016","capacity_details":"BESS: 1MW/2MWh","capacity_mw":1.0,"capacity_mw_raw":"1","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:43:00.958126","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"AUS-ES-0016-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.nengyuanjie.net/article/81954.html\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"太平洋水电澳洲公司","project_developer_en":"Pacific Hydropower Australia Pty Ltd","project_stage":"投入运营","project_summary":"中电国际所属太平洋水电澳洲公司在澳大利亚维多利亚州开发建设了一个1MW/2MWh的储能试点项目，该项目已成功并网，旨在提高电网稳定性并为当地提供高峰用电负荷支持。","publish_date":"2023-10-12 22:25:03","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/49101.html\"]","storage_energy_mwh":2.0,"storage_power_mw":1.0,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"AUS-ES-0016","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["existing_storage_numeric","storage_text_signal"]}
