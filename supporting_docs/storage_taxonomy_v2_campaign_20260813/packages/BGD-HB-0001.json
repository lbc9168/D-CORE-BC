{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"孟加拉国","country_iso":"BGD","created_at":"2026-03-23T09:36:21.302102","excluded":0,"excluded_reason":null,"id":"BGD-HB-0001","ldc":"Yes","location":"波拉岛","location_norm":null,"name_en_quality":"ai_translated","project_name":"孟加拉国波拉岛5口井钻井项目","project_name_en":"Bangladesh Bhola Island 5-Well Drilling Project","subcategory":null},"events":[{"articles":[{"author":"中国石化石油工程公司","content":"2月17日，孟加拉项目部就传来令人振奋的捷报——成功与孟加拉BAPEX公司签订波拉岛5口井钻井项目合同。\n此次签约的波拉岛项目是孟加拉国能源重点工程。项目涉及5口井，其中4口为评价与开发一体井、1口为勘探井，核心是为当地工业、电力供应提供稳定能源支撑。\n波拉岛作为孟加拉国南部重要能源勘探区块，是第一次有中国企业开展钻井作业。该区块开发既是孟加拉国提升能源自给能力的关键举措，也是中孟能源合作的深化延伸，得到了孟加拉国相关领域人士的认可与期待。\n该项目采用国际招标“交钥匙”模式，吸引了18家中外优秀企业参与角逐。孟加拉项目部凭借优良的钻井装备、成熟的施工技术、丰富的海外运营经验及专业的项目执行能力，精准对接国际标准、高效推进项目筹备，经多轮技术交流及严格评审，最终成功签约，承担该项目钻井施工任务。\n此次签约锁定了未来两年在孟的连续工作量，为深耕孟加拉能源市场、扩大海外业务版图奠定了坚实基础。","content_sha256":"0007ecf7e0c00288717fa369375a404002bf01a93a9faf0e942abb6a7247a6f0","id":26,"publish_date":"2026-02-27 12:20:02","title":"胜利石油工程渤海钻井总公司成功签约波拉岛重点项目","title_sha256":"50770edb41f13c12eda64a3ceb8e9a73460f755ff3c95df226469c28adaf8d79","url":"https://news.goalfore.cn/topstories/detail/92989.html"}],"event":{"additional_remarks":"","canonical_id":"BGD-HB-0001","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:36:21.302111","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"BGD-HB-0001-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"http://www.sinopecgroup.com/group/000/000/060/60897.shtml\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"孟加拉BAPEX公司","project_developer_en":"Bangladesh Petroleum Exploration Company (BAPEX)","project_stage":"签约","project_summary":"胜利石油工程渤海钻井总公司在孟加拉国波拉岛成功签约5口井钻井项目合同，该项目是孟加拉国能源重点工程，旨在为当地工业和电力供应提供稳定能源支撑。","publish_date":"2026-02-27 12:20:02","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/92989.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"BGD-HB-0001","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
