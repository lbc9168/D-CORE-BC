{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"印度尼西亚","country_iso":"IDN","created_at":"2026-03-23T10:37:53.658051","excluded":0,"excluded_reason":null,"id":"IDN-HB-0032","ldc":"No","location":"亚齐","location_norm":"亚齐省","name_en_quality":"ai_translated","project_name":"印尼米拉务新能源项目","project_name_en":"Indonesia Merauke New Energy Project","subcategory":null},"events":[{"articles":[{"author":"大唐海投公司","content":"11月22日，印尼国家电力公司亚齐地区总经理帕鲁利安到印尼米拉务公司开展走访交流。印尼米拉务公司领导班子成员参加交流活动。\n印尼米拉务公司全面介绍了中国大唐在光伏、风电、水电等新能源开发方面专业优势和发展战略，详细介绍了工程建设、净可容量测试、商业运营取证等情况，表达了按时加入印尼国家电力公司供电序列，保持机组可靠运行的信心和决心。希望在印尼国家电力公司的支持下，双方深化合作，共谋发展，把米拉务项目建设成为科技创新、数字智慧、火光互补、节能环保的中印尼示范企业，为保障印尼亚齐电网稳定提供有力支撑。\n帕鲁利安对印尼米拉务公司能够按期投产表示赞赏，对印尼米拉务公司在电力供应方面做出积极贡献表示感谢。帕鲁利安介绍了印尼国家电力公司亚齐地区发展规划，并表示将继续支持大唐集团在印尼亚齐的新能源发展，希望双方加强新能源领域的合作，帮助亚齐地区实现能源供给多元化。\n交流活动中，帕鲁利安现场查看了机组运行情况，详细询问了运行调整、电网调度等情况，对该公司保持机组安全稳定运行和高标准的文明生产给予了高度赞扬。\n印尼米拉务公司相关部门、印尼国家电力公司亚齐公司、印尼国家电力公司一期电厂相关人员参加交流活动。","content_sha256":"19adeaa1afecb45f848221d6ccdc3d3f052e040cbcead6a49e84253b348a6455","id":10852,"publish_date":"2023-11-26 12:23:03","title":"印尼国家电力公司亚齐地区总经理帕鲁利安到米拉务公司开展走访交流","title_sha256":"466b0ea8873ed92bca65338fb47733b5a7fb3a5ae5633c12fcb4c6c998788453","url":"https://news.goalfore.cn/topstories/detail/54029.html"}],"event":{"additional_remarks":"","canonical_id":"IDN-HB-0032","capacity_details":"光伏、风电、水电","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:37:53.658233","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"IDN-HB-0032-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.china-cdt.com/dtwz/xwzx/sdbd/2024/12/I1313452463428206592.html\"]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"producti