{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"越南","country_iso":"VNM","created_at":"2026-03-23T09:42:15.096785","excluded":0,"excluded_reason":null,"id":"VNM-HB-0001","ldc":"No","location":"兴安省","location_norm":null,"name_en_quality":"ai_translated","project_name":"越南兴安省龙兴600吨/日固废焚烧发电项目","project_name_en":"Vietnam Hung Yen Province Long Xing 600 t/d Waste-to-Energy Project","subcategory":null},"events":[{"articles":[{"author":"中国化学土木公司","content":"10月5日，中国化学土木公司承建的越南龙兴绿色能源有限公司现代工艺固废焚烧发电厂项目勘察工程正式启动，标志着该项目进入实质性推进阶段。\n项目选址于越南兴安省泰瑞县瑞程乡，总占地面积近6公顷，以 “垃圾减量化、无害化、资源化” 为核心设计导向，是越南兴安省政府推动区域生态转型与绿色经济发展的重点工程。项目设计日处理生活垃圾600吨，建成后年处理总量将达21.9万吨，可有效缓解区域生活垃圾处置压力，直接改善当地生活垃圾堆积造成的环境问题；同步配置15MW发电装机容量，预计年发电量可达1.2亿千瓦时，实现“变废为能”的循环利用，为当地补充绿色电力资源。\n作为中越两国在环保领域深化合作的代表性项目，该项目的正式启动将为双方在绿色技术交流、产业协同上搭建实践平台，进一步夯实中越环保合作基础，树立双边可持续发展合作的良好典范。","content_sha256":"dab8a5c2a10ce74b2f214eec327cad335131db818eb048705c156cdb1ff476e6","id":1595,"publish_date":"2025-10-16 10:36:04","title":"中国化学土木公司承建的越南龙兴固废焚烧发电厂项目勘察工程正式启动","title_sha256":"6881adad1ee97ec3db818e1bb6eea77b80ee311b09ce740e7fb1881997f11a0b","url":"https://news.goalfore.cn/topstories/detail/88702.html"}],"event":{"additional_remarks":"","canonical_id":"VNM-HB-0001","capacity_details":"Waste-to-Energy: 15MW","capacity_mw":15.0,"capacity_mw_raw":"15","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:42:15.096841","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"VNM-HB-0001-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.wannaenergy.com/news/company/detail/1609\"]","planned_complete_date":"","planned_start_date":"2025-10-05","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"越南龙兴绿色能源有限公司","project_developer_en":"Long Xing 