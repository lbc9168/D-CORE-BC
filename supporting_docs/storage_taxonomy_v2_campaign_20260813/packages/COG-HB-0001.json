{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"刚果（布）","country_iso":"COG","created_at":"2026-03-23T09:56:24.539524","excluded":0,"excluded_reason":null,"id":"COG-HB-0001","ldc":"No","location":"黑角市","location_norm":null,"name_en_quality":"ai_translated","project_name":"刚果（布）国家石油公司黑角市办公大楼建设项目二期工程","project_name_en":"Republic of the Congo National Petroleum Corporation Black Sea City Office Building Construction Project Phase II","subcategory":null},"events":[{"articles":[{"author":"国机工程集团","content":"签约刚果（布）国家石油公司\n黑角市办公大楼建设工程二期项目\nCMEC签约刚果（布）国家石油公司黑角市办公大楼建设项目二期工程。这是2024年“黑角市办公大楼建设项目一期工程”的成功延伸，也是CMEC新开发的刚果（布）房建领域新增的又一业绩。\n该项目建设工作为办公大楼的装饰装修工程以及会议中心的主体建设和装饰装修工程，预计将于2026年竣工。建成后的办公大楼\n将\n成为刚果（布）经济中心黑角市的地标性建筑\n，为刚果（布）国家石油公司提供现代化一流的办公环境，满足各类大型会议、商务活动的举办需求。CMEC将科学统筹、重质保量，确保工程如期优质交付。\n中标赞比亚卢西瓦西\n下游水电站改造项目\n经过近两年的不懈努力，CMEC中标赞比亚卢西瓦西下游水电站改造项目。\n该项目是CMEC在承建卢西瓦西上游水电站时，深度挖掘业主需求、主动创造项目机会取得的成果。项目内容包括更换4台水轮发电机组和电气设备以及改造、修缮厂房等，项目完成后将\n恢复该电站的发电能力，\n延长电站使用寿命，有效缓解赞比亚近年来电力短缺的情况\n。","content_sha256":"d00ccfe695b81ef36e44f5832324e4fd599725af47daaa1e3b212e01be190684","id":4497,"publish_date":"2025-03-12 17:53:03","title":"国机工程集团签约刚果布房建项目、中标赞比亚水电站改造项目","title_sha256":"17267c5465f8ddb2d15ee27726622720a3263d33759658eaa359c637055446f6","url":"https://news.goalfore.cn/topstories/detail/79953.html"}],"event":{"additional_remarks":"","canonical_id":"COG-HB-0001","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T09:56:24.539707","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"COG-HB-0001-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.sinomach.com.cn/xwzx/zgsdt/2025_qydt/202502/t20250226_529570.html\"]","planned_complete_date":"2026-01-01","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"刚果（布）国家石油公司","project_developer_en":"National Petroleum Company of Congo (Brazzaville)","project_stage":"签约","project_summary":"中国机械设备工程股份有限公司（CMEC）签约刚果（布）国家石油公司黑角市办公大楼建设项目二期工程。该项目是房建项目，主要进行装饰装修和会议中心建设，预计2026年竣工。","publish_date":"2025-03-12 17:53:03","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/79953.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"COG-HB-0001","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
