{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"No","category":"储能","country":"印度","country_iso":"IND","created_at":"2026-03-23T10:01:32.320866","excluded":0,"excluded_reason":null,"id":"IND-ES-0002","ldc":"No","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"印度5GWh储能项目","project_name_en":"India 5GWh Energy Storage Project","subcategory":null},"events":[{"articles":[{"author":"楚能新能源","content":"12月26日，楚能新能源与印度合作伙伴在楚能全球总部签署了5GWh储能系统项目合作协议，双方将围绕楚能5MWh电池预制舱CORNEX M5储能系统项目开展深度合作。此次合作标志着楚能正式进入印度市场，为未来进一步拓展全球市场奠定了坚实基础。\n根据协议，楚能新能源将与印度合作伙伴达成5GWh储能项目框架合作协议，为印度市场提供楚能自主研发的20尺5MWh电池预制舱CORNEX M5系列产品。其中有两期项目将于2025年开工，规模分别为220MWh和750MWh。该项目对于稳定当地电力供应、推动印度能源结构优化具有重要意义。此次合作是楚能国际化战略的重要节点，未来楚能将继续秉持绿色发展理念，为全球客户提供优质的新能源解决方案，为构建清洁、低碳、安全、高效的全球能源体系贡献力量。","content_sha256":"8c8b2439d550ea47523c73acd3b1626ab7d62b2fee60c8165c2d33e5e2336a92","id":5262,"publish_date":"2024-12-27 09:28:04","title":"楚能国际化进程再加速，签订5GWh印度储能项目合作协议","title_sha256":"cee81618c0f652858211c966b42ec420d147116884b480928921827aecc88f67","url":"https://news.goalfore.cn/topstories/detail/76816.html"}],"event":{"additional_remarks":"","canonical_id":"IND-ES-0002","capacity_details":"BESS: 5000MWh","capacity_mw":5000.0,"capacity_mw_raw":"5000","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-03-23T10:01:32.321233","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"IND-ES-0002-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[]","official_website_links":"[\"https://www.cn-ne.cn/Index/news_detail/id/1357.html\"]","planned_complete_date":"","planned_start_date":"2025-01-01","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"楚能新能源; 印度合作伙伴","project_developer_en":"CHN Energy; Indian Partner","project_stage":"签约","project_summary":"中国企业楚能新能源与印度合作伙伴签订了5GWh储能系统