{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"No","category":"综合能源","country":"西班牙","country_iso":"ESP","created_at":"2026-04-10T08:38:17.669487","excluded":0,"excluded_reason":null,"id":"ESP-HB-0006","ldc":"No","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"西班牙404.9MW风光项目","project_name_en":"Spain 404.9MW Wind and Solar Project (Horus)","subcategory":null},"events":[{"articles":[{"author":"三峡国际","content":"2021年8月12日，三峡国际所属三峡欧洲公司顺利完成西班牙Horus项目交割，继Daylight光伏项目后，在西班牙新能源市场再下一城，清洁能源运营装机规模达到百万千瓦，并实现风电和光伏的资产优化配置。\nHorus项目包含位于西班牙境内的11座风电站和1座光伏电站，总装机40.49万千瓦，项目拥有具备长期监管收入、运营安全稳定、设备质量可靠等优势。\n三峡国际利用多年来在欧洲资本市场和清洁能源市场树立的良好声誉，克服疫情不利影响，经过审慎研究和艰苦谈判，成功于2021年2月18日与卖方签订交易协议，在满足所有交割条件后实现项目交割。\nHorus项目交割是三峡国际打造国际业务精品工程的有益尝试，有利于公司进一步整合现有资源，发挥战略协同作用，实现价值创造，推动三峡集团海外业务高质量发展，为集团公司创建世界一流示范企业作出贡献。\n三峡国际将持续聚焦国际清洁能源投资业务，致力于全球清洁能源开发，为实现碳达峰、碳中和目标，促进经济社会发展全面绿色转型贡献三峡力量。","content_sha256":"8c531bbae7d383b65b482c39d0ff6c8cd12be2691554923fffd7f48b0412cb01","id":18292,"publish_date":"2021-08-16 07:30:02","title":"三峡西班牙Horus项目完成交割","title_sha256":"cf2367d231e023df4f4feb554dad578d4751d571e69d4c9a48a48eca55a3006b","url":"https://news.goalfore.cn/topstories/detail/21849.html"}],"event":{"additional_remarks":"","canonical_id":"ESP-HB-0006","capacity_details":"Wind: 11 stations, PV: 1 station","capacity_mw":404.9,"capacity_mw_raw":"404.9","capacity_source":"legacy","contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-04-10T08:38:17.671990","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"ESP-HB-0006-01","investment_date":"2021-08-12","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"http://www.ouhua.info/2025/0125/54343.html\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"三峡国际能源投资集团有限公司","project_developer_en":"CTGI","project_stage":"收购","project_summary":"中国长江三峡集团通过其子公司三峡国际，在西班牙完成了Horus项目的交割。该项目包含11座风电站和1座光伏电站，总装机容量为40.49万千瓦，是三峡集团在西班牙新能源市场的又一重要布局。","publish_date":"2021-08-16 07:30:02","pv_capacity_mw":null,"source_links":"[\"https://news.goalfore.cn/topstories/detail/21849.html\"]","storage_energy_mwh":null,"storage_power_mw":null,"total_investment_usd":null,"total_investment_usd_raw":"","transmission_capacity_mw":null,"verification_confidence":null,"verification_sources":null,"verification_status":"unverified","voltage_kv":null}}],"evidence_policy":{"exact_quote_required":true,"quote_must_not_cross_surfaces":true,"valid_surfaces":["title","body"]},"project_id":"ESP-HB-0006","schema_version":"storage-taxonomy-evidence-package-v1","selection_reasons":["active_hybrid_category"]}
