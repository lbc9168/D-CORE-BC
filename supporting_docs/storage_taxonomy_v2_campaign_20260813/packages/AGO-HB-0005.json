{"campaign_version":"storage-taxonomy-v2-20260813","canonical":{"bri_country":"Yes","category":"综合能源","country":"安哥拉","country_iso":"AGO","created_at":"2026-04-10T09:08:28.393763","excluded":0,"excluded_reason":null,"id":"AGO-HB-0005","ldc":"Yes","location":"","location_norm":null,"name_en_quality":"ai_translated","project_name":"安哥拉光伏储能一体化电站项目","project_name_en":"Angola PV Energy Storage Integrated Power Station EPC Project","subcategory":"光储"},"events":[{"articles":[{"author":"","content":"10月16日，由澳门特区政府、国务院国资委共同主办的2019央企支持澳门中葡平台建设高峰会上，\n中国建材股份\n总裁彭寿与\n安哥拉昆腾能源解决方案公司\n执行总裁佛朗西斯科分别代表中国建材工程与昆腾能源就\n安哥拉光伏储能一体化电站EPC项目\n签署协议。\n该项目将成为\n安哥拉首个光储一体化项目，同时也将是非洲地区最大的光储一体化项目\n。\n项目将为安哥拉最大的国有钻石集团Endiama旗下22个钻石矿安装光伏储能一体化电站系统，以清洁可再生的太阳能发电取代当地的高成本高污染的柴油发电。\n中国建材集团副总经理王于猛、国际合作部总经理李志威、澳门水泥厂董事总经理程翔等参加相关活动。","content_sha256":"38ae7ab849b861aa48491ea9edc7ae7b2b002d2ab4fa87b2a48b8d805318ef04","id":22772,"publish_date":"2019-10-22 13:30:32","title":"中国建材集团与安哥拉昆腾能源签约非洲地区最大光储一体化项目","title_sha256":"3fdec8814715895ec3a1de34e681f9c39cbca79cb41bdacbade25f5c2cc3642a","url":"https://news.goalfore.cn/topstories/detail/11570.html"}],"event":{"additional_remarks":"","canonical_id":"AGO-HB-0005","capacity_details":"","capacity_mw":null,"capacity_mw_raw":"","capacity_source":null,"contract_amount_usd":null,"contract_amount_usd_raw":null,"created_at":"2026-04-10T09:08:28.395653","financing_amount_usd":null,"financing_amount_usd_raw":null,"financing_model":"Unknown","financing_model_details":"","id":"AGO-HB-0005-01","investment_date":"","line_length_km":null,"needs_manual_review":0,"non_official_website_links":"[\"https://www.pv-magazine-china.com/2025/12/13/%E9%9D%9E%E6%B4%B2%E6%9C%80%E5%A4%A7%E7%A6%BB%E7%BD%91%E5%85%89%E5%82%A8%E9%A1%B9%E7%9B%AE%E5%9C%A8%E5%AE%89%E5%93%A5%E6%8B%89%E5%B9%B6%E7%BD%91%E8%BF%90%E8%A1%8C/\"]","official_website_links":"[]","planned_complete_date":"","planned_start_date":"","production_capacity_unit":null,"production_capacity_value":null,"project_developer":"安哥拉昆腾能源解决方案公司","pr